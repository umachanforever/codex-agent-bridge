{
  "name": "codex-agent-bridge",
  "version": "0.3.0",
  "private": true,
  "description": "A local Codex app-server bridge for agent clients, with a web console and Docker deployment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umachanforever/codex-agent-bridge.git"
  },
  "homepage": "https://github.com/umachanforever/codex-agent-bridge#readme",
  "bugs": "https://github.com/umachanforever/codex-agent-bridge/issues",
  "license": "MIT",
  "keywords": [
    "codex",
    "openai",
    "chat-completions",
    "proxy",
    "cli",
    "app-server"
  ],
  "type": "module",
  "bin": {
    "codex-agent-bridge": "dist/bin.js",
    "codex-openai-proxy": "dist/bin.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "protocol/schemas",
    "protocol/VERSION.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "check": "npm run format:check && npm run lint && npm run check:protocol && npm test",
    "check:protocol": "node scripts/check-protocol-clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "lint": "eslint .",
    "models:live": "npm run build --silent && node scripts/list-models-live.mjs",
    "prepack": "npm run build && npm run build:web",
    "serve": "node dist/bin.js serve",
    "start": "npm run build && npm run serve",
    "test": "npm run build --silent && npm run test:typecheck --silent && vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:live": "npm run build --silent && npm run test:typecheck --silent && vitest run --config vitest.live.config.js",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "update:codex": "node scripts/update-codex.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "fast-check": "^4.9.0",
    "fflate": "0.8.3",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@openai/codex": "0.155.1",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "7.0.2",
    "pdfjs-dist": "4.10.38",
    "read-excel-file": "9.3.10"
  }
}
